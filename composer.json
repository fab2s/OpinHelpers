{
    "name" : "fab2s/opinhelpers",
    "description" : "A collection of Simple, opinionated yet hopefully useful PHP Helper Libs",
    "type" : "library",
    "authors" : [{
        "name" : "Fabrice de Stefanis"
    }],
    "keywords" : [
        "PHP",
        "Simple",
        "Helpers",
        "Utf8",
        "String",
        "Math",
        "BOM",
        "BcMath",
        "FileLock"
    ],
    "license" : [
        "MIT"
    ],
    "require" : {
        "php": "^8.2",
        "fab2s/math": "^3.0",
        "fab2s/filelock": "^1.0",
        "fab2s/strings": "^1.0",
        "fab2s/utf8": "^1.0",
        "fab2s/bom": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "laravel/pint": "^1.21.2"
    },
    "autoload": {
        "files": [
            "src/deprecated.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "fab2s\\OpinHelpers\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "rm -rf .*.cache"
        ],
        "post-install-cmd": [
            "rm -rf .*.cache"
        ],
        "fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pint --ansi --config pint.json --"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit --colors --"
        ],
        "cov": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit --colors --coverage-html ./cov --"
        ]
    }
}
